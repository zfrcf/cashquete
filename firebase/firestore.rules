rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Configuration publique en lecture, modifiable uniquement via la console/admin
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Le client ne peut modifier que son nom d'affichage :
      // les points et soldes ne bougent que via les Cloud Functions.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow create, delete: if false;

      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /withdrawals/{wId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
